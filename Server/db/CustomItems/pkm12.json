    "locales": {
      "en": {
        "name": "PKM-12 belt-fed shotgun",
        "shortName": "PKM-12",
        "description": "A PKM general-purpose machine gun rebuilt by a Tarkov workshop to run 12 gauge shells from a belt. The rifle barrel was swapped for a heavy smoothbore tube that takes Saiga-12 muzzle devices, and the 100-round box was enlarged to hold a 50-shell belt with widened links. Nobody asked for it, and nobody can stop it."
      },
      "po": {
        "name": "Escopeta de fita PKM-12",
        "shortName": "PKM-12",
        "description": "Uma metralhadora PKM refeita numa oficina de Tarkov para disparar cartuchos de calibre 12 em fita. O cano de fuzil virou um tubo liso e grosso que aceita os bocais da Saiga-12, e a caixa de 100 cresceu para levar uma fita de 50 cartuchos com elos alargados. Ninguém pediu, e ninguém consegue impedir."
      },
      "ru": {
        "name": "Ленточное ружье ПКМ-12 12к",
        "shortName": "ПКМ-12",
        "description": "Единый пулемет ПКМ, переделанный в одной из мастерских Таркова под ленту с патронами 12 калибра. Винтовочный ствол заменили тяжелой гладкой трубой, на которую ставятся дульные устройства от Сайги-12, а короб на 100 патронов увеличили под ленту на 50 патронов с расширенными звеньями. Никто об этом не просил, и никто не сможет это остановить."
      }
    },
    "fleaPriceRoubles": 110000,
